#include <windows.h>

// Application icon. MSVC uses the lowest-numbered ICON resource as the
// executable's icon, so this is what Explorer, the taskbar, Alt-Tab, and the
// installer's shortcuts display. SDL also derives the window icon from it.
// Path is relative to this .rc file (repo root).
1 ICON "assets/screenshots/aimutt-logo.ico"

// Version / product information shown in the EXE's Properties > Details dialog
// and used by Windows (and SmartScreen) to identify the application.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "aimutt.com"
            VALUE "FileDescription",  "RetroDocWriter"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "RetroDocWriter"
            VALUE "OriginalFilename", "RetroDocWriter.exe"
            VALUE "ProductName",      "RetroDocWriter"
            VALUE "ProductVersion",   "0.2.0.0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 aimutt.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
